---
# ┌─────────────────────────────────────────────────────────────┐
# │  REGISTRY SKILL TEMPLATE                                    │
# │  For skills distributed via `skills add <name>` CLI         │
# │                                                             │
# │  Author path:     skills/<skill-name>/SKILL.md              │
# │  Installed path:  .skills/<skill-name>/  (in downstream)    │
# └─────────────────────────────────────────────────────────────┘
name: "{{skill-name}}"
# ↑ kebab-case, must match directory name exactly

version: "1.0.0"
# ↑ Semver: MAJOR.MINOR.PATCH — start at 1.0.0

description: "{{One to two sentences: what this skill enforces/teaches and when it activates}}"
# ↑ CRITICAL for agent routing — be precise and searchable
# ↑ See references/frontmatter-spec.md for detailed guidance

triggers:
  globs:
    - "{{glob_pattern}}"
    # Examples: "src/**/*.ts", "*.config.{js,ts}", "src/modules/**/domain/**"
    # Use [] for intent-only activation
  intents:
    - "{{user_intent_1}}"
    - "{{user_intent_2}}"
    # 2-5 phrases covering common user requests
  default_mode: "auto"
  # "auto" (recommended) | "always" (foundational only) | "manual" (rare/dangerous)

dependencies:
  # Flat list of other skill names required (kebab-case)
  # Example: - "typescript-strict-rules"
  []
---

